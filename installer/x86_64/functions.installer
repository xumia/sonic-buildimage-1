# -*-Shell-script-*-
# functions.installer
# Common installer script routines
#

# delete all boot entries of certain label
delete_boot_entry()
{
	entry=$1

	for b in $(efibootmgr | grep "$entry" | awk '{ print $1 }') ; do
		local num=${b#Boot}
		# Remove trailing '*'
		num=${num%\*}
		efibootmgr -b $num -B > /dev/null 2>&1
	done
}

# create and remove a dummy EFI boot variable to test basic
# EFI variable operations. Sometimes creating EFI variables can
# fail due to NVRAM is running low on space and BIOS/EFI Garbage
# Collection does not kick in until reboot.
# If this happens, we should not proceed but reboot.
efi_dummy_var_check()
{
    dummyboot="Dummy Boot Test"
    delete_boot_entry "$dummyboot"
    efibootmgr --create --label "$dummyboot" --quiet || {
        echo "Warning! Fail to create/delete test EFI variable. Reboot platform."
        # exit 0 will trigger a reboot from onie exec_installer
        exit 0
    }
    delete_boot_entry "$dummyboot"
}

# check if we are running on BSP ditribution
running_on_bsp()
{
	$(cat /etc/os-release | grep -q "Cisco BSP") && {
		return 0
	}
	return 1
}

# check if we are running on ONIE
running_on_onie()
{
	$(uname -a | grep -q onie) && {
		return 0
	}
	return 1
}

# get install disk for running platform
get_install_disk()
{
	blk_dev=
	if running_on_onie; then
		blk_dev=$(blkid | grep ONIE-BOOT | awk '{print $1}' | \
				sed -e 's/[0-9]://' | head -n 1)
	else
		. /etc/init.d/functions.platform
		blk_dev=$(get_platform_disk_device)
	fi
	if [ "$blk_dev" ]; then
		echo $blk_dev
		return 0
	fi
	return 1
}

# does the platform have ONIE embedded
is_onie_platform()
{
	blk_dev=$(get_install_disk)
	if sgdisk -p $blk_dev | grep -q ONIE-BOOT; then
		return 0
	fi
	return 1
}

# mount onie tools
mount_onie_tools()
{
	mnt_point=/mnt/onie-tools
	if ! mount | grep -q $mnt_point; then
		mkdir -p $mnt_point
		mount LABEL=ONIE-BOOT $mnt_point
	fi
}


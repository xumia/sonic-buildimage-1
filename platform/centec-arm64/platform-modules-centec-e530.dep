MPATH		:= $($(CENTEC_E530_48T4X_P_PLATFORM_MODULE)_SRC_PATH)
DEP_FILES	:= $(SONIC_COMMON_FILES_LIST) platform/centec-arm64/platform-modules-centec-e530.mk platform/centec-arm64/platform-modules-centec-e530.dep
DEP_FILES	+= $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES	+= $(shell git ls-files $(MPATH))

$(CENTEC_E530_48T4X_P_PLATFORM_MODULE)_CACHE_MODE  := GIT_CONTENT_SHA
$(CENTEC_E530_48T4X_P_PLATFORM_MODULE)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(CENTEC_E530_48T4X_P_PLATFORM_MODULE)_DEP_FILES   := $(DEP_FILES)

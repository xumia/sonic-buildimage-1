DEP_FILES   := $(SONIC_COMMON_FILES_LIST) platform/centec-arm64/sai.mk platform/centec-arm64/sai.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
SAI_FLAGS   := $(shell wget --spider --server-response $(CENTEC_SAI)_URL 2>&1 \
               | grep -E --  'Content|ETag'|sha256sum|awk '{print $$1}' )

$(CENTEC_SAI)_CACHE_MODE  := GIT_CONTENT_SHA
$(CENTEC_SAI)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(CENTEC_SAI)_DEP_FILES   := $(DEP_FILES)
